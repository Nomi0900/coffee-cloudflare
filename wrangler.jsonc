{
  "name": "coffee-cloudflare",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "build": { "command": "node scripts/build.js" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*", "/", "/index.html"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "coffee-db", "database_id": "7058a93a-2822-4f19-8b1b-8a5946cd331e" }
  ]
}
